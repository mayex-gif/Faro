POSTGRES_DB=faro
POSTGRES_USER=faro
POSTGRES_PASSWORD=faro

# Clave con la que el backend firma las sesiones (obligatoria, 32 caracteres o más). Este valor es SOLO para la compu:
# en Render se carga otra, generada al azar (por ejemplo con: openssl rand -hex 32). Nunca usar esta en la nube.
FARO_JWT_SECRET=clave-solo-para-desarrollo-local-cambiala-si-queres-0123456789

# Almacén de fotos de las OT (comentarios con fotos).
#   memoria = no hace falta nada más: las fotos viven en la memoria del backend y se pierden al reiniciarlo (solo desarrollo).
#   s3      = RustFS en Docker: descomentar las dos líneas de abajo e inventar usuario y clave (8 caracteres o más).
FARO_ALMACEN=memoria
# FARO_S3_ACCESS_KEY=mi-usuario
# FARO_S3_SECRET_KEY=una-clave-de-8-o-mas
# En Render NO se define FARO_ALMACEN: ahí va S3 (ver DESPLIEGUE.md, punto 9).
